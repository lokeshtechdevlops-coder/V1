DATABASE_URL=postgresql+psycopg://hospital:hospital_local@localhost:5432/hospital
# Generate with: ..\..\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_DIR=../storage
# Hosted NVIDIA NIM: both models must be available to your account.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSIONS=2048
RETRIEVAL_MAX_COSINE_DISTANCE=0.5
# Explicit local demo: restricted structured tools and keyword retrieval, no pretend AI.
AI_MODE=demo
